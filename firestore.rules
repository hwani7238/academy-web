rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Operations data is available only through server APIs with role/device checks.
    // Keep financial records out of the broad legacy students subtree.
    match /opsAccounts/{path=**} { allow read, write: if false; }
    match /opsAttendance/{path=**} { allow read, write: if false; }
    match /opsInvoices/{path=**} { allow read, write: if false; }
    match /opsPayments/{path=**} { allow read, write: if false; }
    match /opsNotices/{path=**} { allow read, write: if false; }
    match /opsAudit/{path=**} { allow read, write: if false; }
    match /opsDevices/{path=**} { allow read, write: if false; }
    match /opsPairing/{path=**} { allow read, write: if false; }
    function userDoc(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(userDoc(request.auth.uid)) &&
        get(userDoc(request.auth.uid)).data.role in ['admin', 'wonjang', 'siljang'];
    }

    function isApprovedTeacher() {
      return isAuthenticated() &&
        exists(userDoc(request.auth.uid)) &&
        get(userDoc(request.auth.uid)).data.role == 'teacher' &&
        (
          !('status' in get(userDoc(request.auth.uid)).data) ||
          get(userDoc(request.auth.uid)).data.status == 'approved'
        );
    }

    function isStaff() {
      return isAdmin() || isApprovedTeacher();
    }

    function isValidTeacherSignup(userId) {
      return isAuthenticated() &&
        request.auth.uid == userId &&
        !exists(userDoc(userId)) &&
        request.resource.data.keys().hasOnly([
          'email',
          'name',
          'phone',
          'role',
          'status',
          'subject',
          'createdAt',
          'requestedAt'
        ]) &&
        request.resource.data.email is string &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 50 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 30 &&
        request.resource.data.role == 'teacher' &&
        request.resource.data.status == 'pending' &&
        request.resource.data.subject is string &&
        request.resource.data.subject.size() > 0 &&
        request.resource.data.subject.size() <= 30 &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.requestedAt is timestamp;
    }

    match /students/{studentId}/logs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.authorId == request.auth.uid;
      // Content edits and read markers use server transactions. Clients cannot
      // reset a view marker or bypass the unread-only rule.
      allow update: if false;
      allow delete: if isStaff();
      match /edits/{editId} { allow read, write: if false; }
    }

    match /{path=**}/logs/{logId} {
      allow read: if isStaff();
    }

    match /students/{studentId} {
      allow read, write: if isStaff();

      match /{childCollection}/{childId}/{rest=**} {
        allow read, write: if childCollection != 'logs' && isStaff();
      }
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow read, create, update, delete: if isAdmin();
      allow create: if isValidTeacherSignup(userId);
    }

    match /daily_stats/{date} {
      allow read: if true;
      allow write: if true;
    }
  }
}
