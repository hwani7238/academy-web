NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_admin_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# NHN Cloud AlimTalk (Notification)
NHN_APP_KEY=your_nhn_app_key
NHN_SECRET_KEY=your_nhn_secret_key
NHN_SENDER_KEY=your_kakao_sender_key_or_plus_friend_id

# Attendance and billing automation (server only)
NHN_ATTENDANCE_TEMPLATE=
NHN_BILLING_TEMPLATE=
APP_ORIGIN=https://wheemusic.com
